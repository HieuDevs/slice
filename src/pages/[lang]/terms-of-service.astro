---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import {
  languages,
  useTranslations,
  getLocalizedPath,
  type Language,
} from "@/i18n";

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const sections = [
  { key: "about", icon: "heroicons:cube" },
  { key: "eligibility", icon: "heroicons:user-circle" },
  { key: "accounts", icon: "heroicons:key" },
  { key: "use", icon: "heroicons:document-text" },
  { key: "content", icon: "heroicons:share" },
  { key: "ai", icon: "heroicons:sparkles" },
  { key: "subscription", icon: "heroicons:credit-card" },
  { key: "data", icon: "heroicons:shield-check" },
  { key: "thirdParty", icon: "heroicons:building-office" },
  { key: "availability", icon: "heroicons:globe-alt" },
  { key: "device", icon: "heroicons:device-phone-mobile" },
  { key: "liability", icon: "heroicons:exclamation-triangle" },
  { key: "changes", icon: "heroicons:pencil-square" },
  { key: "termination", icon: "heroicons:no-symbol" },
  { key: "contact", icon: "heroicons:envelope" },
] as const;
---

<Layout
  title="Terms of Service"
  currentPath={getLocalizedPath("/terms-of-service", lang)}
  lang={lang}
>
  <section
    class="py-24 bg-linear-to-b from-cream-100 to-cream-50 dark:from-dark-900 dark:to-dark-950 relative overflow-hidden"
  >
    <div
      class="absolute top-0 left-1/4 w-96 h-96 bg-slice-400/10 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 right-1/4 w-80 h-80 bg-purple-400/10 rounded-full blur-3xl"
    >
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-slice-100 dark:bg-slice-900/30 rounded-full text-slice-700 dark:text-slice-400 font-medium text-sm mb-6 opacity-0 animate-fade-in"
        >
          <Icon name="heroicons:scale" class="w-4 h-4" />
          {t("terms.badge")}
        </div>
        <h1
          class="section-title mb-6 opacity-0 animate-slide-up animation-delay-100"
        >
          {t("terms.title")}
        </h1>
        <p
          class="section-subtitle mx-auto opacity-0 animate-slide-up animation-delay-200"
        >
          {t("terms.lastUpdated")}
        </p>
      </div>

      <div
        class="bg-white dark:bg-dark-800 rounded-2xl p-8 shadow-card opacity-0 animate-slide-up animation-delay-300"
      >
        <p class="text-dark-600 dark:text-dark-300 leading-relaxed">
          {t("terms.intro")}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-dark-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-6">
        {
          sections.map((section, index) => (
            <div
              class="bg-cream-50 dark:bg-dark-800 rounded-2xl p-8 opacity-0 animate-slide-up"
              style={`animation-delay: ${(index + 4) * 30}ms`}
            >
              <h2 class="font-display text-xl font-bold text-dark-900 dark:text-cream-100 mb-3 flex items-center gap-3">
                <span class="w-10 h-10 bg-slice-500 rounded-xl flex items-center justify-center shrink-0">
                  <Icon name={section.icon} class="w-5 h-5 text-white" />
                </span>
                {t(`terms.sections.${section.key}.title`)}
              </h2>
              <p class="text-dark-600 dark:text-dark-300 leading-relaxed">
                {t(`terms.sections.${section.key}.content`)}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 bg-cream-50 dark:bg-dark-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-dark-500 dark:text-dark-400 text-sm">
        {t("terms.questions")}
      </p>
      <a
        href="mailto:hieubh130700@gmail.com"
        class="inline-flex items-center gap-2 mt-4 text-slice-600 dark:text-slice-400 hover:text-slice-500 dark:hover:text-slice-300 font-medium transition-colors"
      >
        <Icon name="heroicons:envelope" class="w-5 h-5" />
        hieubh130700@gmail.com
      </a>
    </div>
  </section>
</Layout>
