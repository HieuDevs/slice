---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import {
  languages,
  useTranslations,
  getLocalizedPath,
  type Language,
} from "@/i18n";

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);
---

<Layout
  title="Privacy Policy"
  currentPath={getLocalizedPath("/privacy-policy", lang)}
  lang={lang}
>
  <section
    class="py-24 bg-linear-to-b from-cream-100 to-cream-50 dark:from-dark-900 dark:to-dark-950 relative overflow-hidden"
  >
    <div
      class="absolute top-0 left-1/4 w-96 h-96 bg-slice-400/10 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 right-1/4 w-80 h-80 bg-purple-400/10 rounded-full blur-3xl"
    >
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 bg-slice-100 dark:bg-slice-900/30 rounded-full text-slice-700 dark:text-slice-400 font-medium text-sm mb-6 opacity-0 animate-fade-in"
        >
          <Icon name="heroicons:shield-check" class="w-4 h-4" />
          {t("privacy.badge")}
        </div>
        <h1
          class="section-title mb-6 opacity-0 animate-slide-up animation-delay-100"
        >
          {t("privacy.title")}
        </h1>
        <p
          class="section-subtitle mx-auto opacity-0 animate-slide-up animation-delay-200"
        >
          {t("privacy.lastUpdated")}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-dark-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg dark:prose-invert max-w-none">
        <div class="bg-cream-50 dark:bg-dark-800 rounded-2xl p-8 mb-8">
          <p class="text-dark-600 dark:text-dark-300 leading-relaxed">
            {t("privacy.intro")}
          </p>
        </div>

        <div class="space-y-8">
          <div class="bg-cream-50 dark:bg-dark-800 rounded-2xl p-8">
            <h2
              class="font-display text-2xl font-bold text-dark-900 dark:text-cream-100 mb-4 flex items-center gap-3"
            >
              <span
                class="w-10 h-10 bg-slice-500 rounded-xl flex items-center justify-center shrink-0"
              >
                <Icon name="heroicons:user-circle" class="w-5 h-5 text-white" />
              </span>
              {t("privacy.sections.information.title")}
            </h2>
            <p class="text-dark-600 dark:text-dark-300 leading-relaxed">
              {t("privacy.sections.information.content")}
            </p>
          </div>

          <div class="bg-cream-50 dark:bg-dark-800 rounded-2xl p-8">
            <h2
              class="font-display text-2xl font-bold text-dark-900 dark:text-cream-100 mb-4 flex items-center gap-3"
            >
              <span
                class="w-10 h-10 bg-slice-500 rounded-xl flex items-center justify-center shrink-0"
              >
                <Icon name="heroicons:cog-6-tooth" class="w-5 h-5 text-white" />
              </span>
              {t("privacy.sections.usage.title")}
            </h2>
            <p class="text-dark-600 dark:text-dark-300 leading-relaxed">
              {t("privacy.sections.usage.content")}
            </p>
          </div>

          <div class="bg-cream-50 dark:bg-dark-800 rounded-2xl p-8">
            <h2
              class="font-display text-2xl font-bold text-dark-900 dark:text-cream-100 mb-4 flex items-center gap-3"
            >
              <span
                class="w-10 h-10 bg-slice-500 rounded-xl flex items-center justify-center shrink-0"
              >
                <Icon name="heroicons:lock-closed" class="w-5 h-5 text-white" />
              </span>
              {t("privacy.sections.security.title")}
            </h2>
            <p class="text-dark-600 dark:text-dark-300 leading-relaxed">
              {t("privacy.sections.security.content")}
            </p>
          </div>

          <div class="bg-cream-50 dark:bg-dark-800 rounded-2xl p-8">
            <h2
              class="font-display text-2xl font-bold text-dark-900 dark:text-cream-100 mb-4 flex items-center gap-3"
            >
              <span
                class="w-10 h-10 bg-slice-500 rounded-xl flex items-center justify-center shrink-0"
              >
                <Icon name="heroicons:envelope" class="w-5 h-5 text-white" />
              </span>
              {t("privacy.sections.contact.title")}
            </h2>
            <p class="text-dark-600 dark:text-dark-300 leading-relaxed">
              {t("privacy.sections.contact.content")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-cream-50 dark:bg-dark-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-dark-500 dark:text-dark-400 text-sm">
        {t("privacy.questions")}
      </p>
      <a
        href="mailto:hieubh130700@gmail.com"
        class="inline-flex items-center gap-2 mt-4 text-slice-600 dark:text-slice-400 hover:text-slice-500 dark:hover:text-slice-300 font-medium transition-colors"
      >
        <Icon name="heroicons:envelope" class="w-5 h-5" />
        hieubh130700@gmail.com
      </a>
    </div>
  </section>
</Layout>
